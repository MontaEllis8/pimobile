# PiMobile Server — environment template
# Copy to .env and fill in your values. Never commit .env.

PORT=8787
HOST=0.0.0.0
AUTH_TOKEN=
# AUTH_TOKEN: optional Bearer token for WebSocket auth.
#   - If set: clients must send Authorization: Bearer <token> (or ?token=)
#   - If empty: server runs in OPEN ACCESS mode — any LAN device can control your agent!
#               See SECURITY.md before exposing beyond your trusted LAN.
